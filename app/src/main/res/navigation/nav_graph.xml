<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.josegonzalez.jetpackCrypto.ui.fragments.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_list"
            app:destination="@id/cryptoListFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/cryptoListFragment"
        android:name="com.josegonzalez.jetpackCrypto.ui.fragments.CryptoListFragment"
        android:label="CryptoListFragment"
        tools:layout="@layout/fragment_crypto_list">
        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/cryptoDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cryptoDetailFragment"
        android:name="com.josegonzalez.jetpackCrypto.ui.fragments.CryptoDetailFragment"
        android:label="CryptoDetailFragment"
        tools:layout="@layout/fragment_crypto_detail">
        <argument
            android:name="coin"
            app:argType="com.josegonzalez.jetpackCrypto.domain.model.Coin" />
    </fragment>

</navigation>